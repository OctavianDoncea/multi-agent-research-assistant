{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://multi-agent-research-assistant-pxk1.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://multi-agent-research-assistant-pxk1.onrender.com/health"
    }
  ]
}
