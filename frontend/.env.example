# Leave empty to use same-origin `/api`:
# - local Vite proxies to http://localhost:8000
# - Vercel rewrites /api → Render (see vercel.json)
#
# Do NOT set this on Vercel to the Render URL — that causes CORS on login.
# Only set for special cross-origin setups outside Vercel:
# VITE_API_BASE_URL=https://your-backend.onrender.com
VITE_API_BASE_URL=
